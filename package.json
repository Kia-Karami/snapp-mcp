{
  "name": "snapp-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent quote, book, track and cancel Snapp rides",
  "type": "module",
  "bin": {
    "snapp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kia-Karami/snapp-mcp.git"
  },
  "homepage": "https://github.com/Kia-Karami/snapp-mcp#readme",
  "author": "Kia Karami",
  "keywords": [
    "mcp",
    "snapp",
    "iran",
    "ride-hailing",
    "taxi"
  ]
}
